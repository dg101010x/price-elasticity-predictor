# Copy to .env.local, fill in, and never commit it (.gitignore already
# excludes it). On Vercel, set the same names under Project Settings ->
# Environment Variables instead.
#
# Without the Supabase values the public page works exactly as before and
# the account features answer "not switched on yet". Without GEMINI_API_KEY,
# insights fall back to a template summary built only from the fitted numbers.

# Supabase project -> Settings -> API. The NEXT_PUBLIC_ prefix matches what the
# Vercel <-> Supabase integration writes; this app reads these on the server
# only and never sends a key to the browser. The anon key may be a legacy
# anon JWT or a newer sb_publishable_ key; the service role key a legacy
# service_role JWT or an sb_secret_ key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio -> Get API key. Free tier to start; see
# src/account/llm.py for what changes (nothing in code) when moving to paid.
GEMINI_API_KEY=

# Optional. Pin a specific Gemini model instead of the rolling Flash alias.
# GEMINI_MODEL=

# Local development over plain http only: lets the session cookies work
# without HTTPS. Never set this in production.
# PSL_INSECURE_COOKIES=1
