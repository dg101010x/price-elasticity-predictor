__pycache__/
*.pyc
.venv/
venv/
.env
.vercel/
.DS_Store
.vercel
.env*

# Raw/converted datasets are large (100s of MB) and regenerable via
# src/data_loader.py -- keep them out of git so they don't bloat the repo
# or blow Vercel's deployment size limit.
data/csv/*.csv
data/raw_downloads/
data/processed/*.csv
!data/csv/.gitkeep
# Manifests are small and worth tracking.
!data/manifests/

# Archive clones used by src/screen_archives.py -- multi-GB, regenerable.
data/archives/
# Reference datasets are refetched by src/reference_data.py.
data/csv/reference/

# The M5 Walmart files are large and refetchable via src/walmart_data.py.
data/csv/walmart/
